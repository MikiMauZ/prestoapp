
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- FUNCIONES DE AYUDA ---

    function isSignedIn() {
      return request.auth != null;
    }

    // Obtener datos del perfil de forma eficiente
    function getProfileData() {
      return get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data;
    }

    // --- REGLAS DE PERFILES DE USUARIO ---

    match /userProfiles/{userId} {
      // Un usuario siempre puede leer su propio perfil
      allow read: if isSignedIn() && request.auth.uid == userId;
      
      // Super admins pueden gestionar todos los perfiles
      allow write: if isSignedIn() && getProfileData().role == 'SUPER_ADMIN';
      
      // Permitir actualización de perfil propio (protegiendo el campo role)
      allow update: if isSignedIn() && request.auth.uid == userId && request.resource.data.role == resource.data.role;
    }

    // --- REGLAS DE TENANTS Y SUBCOLECCIONES ---

    match /tenants/{tenantId} {
      // El documento raíz del hotel es legible por cualquier usuario autenticado
      allow get: if isSignedIn();
      
      match /{allSubcollections=**} {
        // Validación unificada para subcolecciones (Logbook, Verificaciones, Inventario, etc.)
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.tenantId == tenantId ||
          get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'SUPER_ADMIN'
        );
        
        allow write: if isSignedIn() && (
          get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.tenantId == tenantId
        );
      }
    }
  }
}
