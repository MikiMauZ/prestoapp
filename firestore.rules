rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPERS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserProfile() {
      return get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data;
    }

    // --- USER PROFILES ---

    match /userProfiles/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId && request.resource.data.role == resource.data.role;
      allow read, write: if isSignedIn() && getUserProfile().role == 'SUPER_ADMIN';
    }

    // --- BLOG POSTS (PUBLIC READ) ---

    match /blogPosts/{postId} {
      allow read: if true;
      allow write: if isSignedIn() && getUserProfile().role == 'SUPER_ADMIN';
    }

    // --- TENANTS AND SUBCOLLECTIONS ---

    match /tenants/{tenantId} {
      allow get: if isSignedIn() || request.auth == null;
      
      match /knowledgeBase/{articleId} {
        allow read: if true; 
      }

      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && (
          getUserProfile().tenantId == tenantId ||
          getUserProfile().role == 'SUPER_ADMIN'
        );
      }
    }
  }
}